{
  "name": "m-yra-discord-bot",
  "version": "2.0.0-refactored",
  "description": "Advanced Discord bot with multi-AI integration, games, and consciousness system",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "dev": "NODE_ENV=development node src/index.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/",
    "db:migrate": "node src/database/migrations.js",
    "db:reset-assistant-memory": "node src/database/reset-assistant-memory.js",
    "db:reset-assistant-memory:dry": "set DRY_RUN=1&& node src/database/reset-assistant-memory.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.71.2",
    "@google/generative-ai": "^0.21.0",
    "@mistralai/mistralai": "^1.3.7",
    "discord.js": "^14.15.3",
    "dotenv": "^16.6.1",
    "joi": "^17.13.3",
    "openai": "^4.77.0",
    "sqlite3": "^5.1.7"
  },
  "devDependencies": {
    "eslint": "^8.55.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.29.0",
    "jest": "^29.7.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
