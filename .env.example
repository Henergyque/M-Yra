.env.example
# ========== DISCORD ==========
DISCORD_TOKEN=your_discord_bot_token_here
CREATOR_ID=your_discord_user_id_here

# ========== AI API KEYS ==========
CLAUDE_API_KEY=sk-ant-your-claude-key-here
OPENAI_API_KEY=sk-your-openai-key-here
GROK_API_KEY=your_grok_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
MISTRAL_API_KEY=your_mistral_api_key_here
PERPLEXITY_API_KEY=your_perplexity_api_key_here

# ========== DISCORD CHANNELS ==========
# Comma-separated channel IDs
THREAD_CHANNEL_IDS=123456789,987654321
CONFESSION_CHANNEL_ID=123456789
COUNTING_CHANNEL_ID=123456789
STORY_LIBRARY_CHANNEL_ID=123456789

# ========== GITHUB (Optional) ==========
GITHUB_REPO=your_github_repo_url_here
GITHUB_TOKEN=optional_github_token

# ========== ENVIRONMENT ==========
NODE_ENV=development
LOG_LEVEL=INFO

# ========== RATE LIMITS ==========
OPUS_MAX_TOKENS_PER_DAY=100000
OPUS_MAX_REQ_PER_MIN=60
MISTRAL_MAX_REQ_PER_MIN=100
GEMINI_MAX_REQ_PER_DAY=1500
PERPLEXITY_MAX_REQ_PER_DAY=1500
GROK_MAX_REQ_PER_DAY=10000
OPENAI_MAX_REQ_PER_MIN=60